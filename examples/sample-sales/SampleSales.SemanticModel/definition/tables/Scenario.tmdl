/// One row per scenario version. PY is not stored: it is AC shifted in time. Use the Scenario Analysis calculation group, do not slice this table.
/// GENERATED by scripts/generate_sample.py. Do not edit; change the script and regenerate.
table Scenario

	column ScenarioKey
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [ScenarioKey]

	/// IBCS scenario code: AC, BU or FC.
	column ScenarioType
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [ScenarioType]

	column VersionCode
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [VersionCode]
		sortByColumn: SortOrder

	column VersionLabel
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [VersionLabel]
		sortByColumn: SortOrder

	column IsLatestFC
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		isNameInferred
		sourceColumn: [IsLatestFC]

	/// n of an n+m forecast: months 1..n were copied from AC.
	column FcActualMonths
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [FcActualMonths]

	column SortOrder
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [SortOrder]

	/// IBCS fill notation (solid, outlined, hatched) for custom visuals and SVG measures.
	column IbcsNotation
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [IbcsNotation]

	partition Scenario = calculated
		mode: import
		source =
				DATATABLE (
					"ScenarioKey", INTEGER,
					"ScenarioType", STRING,
					"VersionCode", STRING,
					"VersionLabel", STRING,
					"IsLatestFC", BOOLEAN,
					"FcActualMonths", INTEGER,
					"SortOrder", INTEGER,
					"IbcsNotation", STRING,
					{
						{ 1, "AC", "AC", "Actual", FALSE, 0, 1, "solid" },
						{ 2, "BU", "BU2025", "Budget 2025", FALSE, 0, 2, "outlined" },
						{ 3, "BU", "BU2026", "Budget 2026", FALSE, 0, 3, "outlined" },
						{ 4, "FC", "FC2026-9+3", "Forecast 2026 (9+3)", TRUE, 9, 4, "hatched" }
					}
				)
